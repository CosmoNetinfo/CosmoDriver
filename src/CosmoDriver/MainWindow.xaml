<Window x:Class="CosmoDriver.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CosmoDriver · by CosmoNet" Width="1240" Height="850" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F6F8" FontFamily="Segoe UI" Language="it-IT" Foreground="#152D3A">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#536976" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,11"/><Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="#E8EEF1"/><Setter Property="Foreground" Value="#152D3A"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#168578"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFB"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2F5"/><Setter Property="Foreground" Value="#536976"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,13"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#536976"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#087A68"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#087A68"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EDF5F2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E0F1EC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F3F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102B36">
      <Grid Margin="24,32,20,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Image x:Name="BrandSymbol" Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,14" AutomationProperties.Name="Logo CosmoDriver: circuito e orbita"/>
          <TextBlock Text="CosmoDriver" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="by CosmoNet" Foreground="#A7C2CD" FontSize="13" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#214653" CornerRadius="7" Padding="14" Margin="0,42,0,0"><StackPanel><TextBlock Text="◉   Controllo driver" Foreground="#8EE8D3" FontWeight="SemiBold"/><TextBlock Text="Il tuo hardware, in chiaro." Foreground="#C0D2D9" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="3">
          <TextBlock Text="SCANSIONE IN LETTURA" FontSize="10" FontWeight="Bold" Foreground="#8EE8D3"/>
          <TextBlock Text="Nessun driver viene modificato durante il controllo." TextWrapping="Wrap" Foreground="#C0D2D9" FontSize="12" LineHeight="19" Margin="0,10,0,22"/>
          <Button Content="Privacy e informazioni" Click="About_Click" Background="#214653" Foreground="White" FontSize="12" Padding="8,10"/>
          <TextBlock Text="VERSIONE 0.2.0  /  WINDOWS" FontSize="10" Foreground="#A7C2CD" Margin="0,20,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="IL TUO PC / DRIVER" FontSize="11" FontWeight="Bold" Foreground="#536976"/><TextBlock Text="Facciamo il punto." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="Scopri i driver installati e le proposte di Windows Update." FontSize="14" Foreground="{StaticResource Muted}"/></StackPanel>
        <Button Grid.Column="1" x:Name="ScanButton" Content="Controlla aggiornamenti" Click="Scan_Click" Background="#087A68" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,18,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock Text="Driver installati" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DriverCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="Inventario locale del dispositivo" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock Text="Aggiornamenti proposti" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UpdateCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,3" Foreground="#97610C"/><TextBlock Text="Da Windows Update / WSUS" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="4" Background="#E0F1EC" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock Text="Modalità di controllo" Foreground="#346256"/><TextBlock Text="Solo lettura" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,5" Foreground="#145747"/><TextBlock Text="Installazione gestita da Windows" FontSize="11" Foreground="#346256"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="2" Background="#E7EEF3" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Pronto per il controllo" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusDetail" Text="La ricerca online parte solo quando la richiedi." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,12,0"/><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,14,0" Foreground="#087A68" AutomationProperties.Name="Scansione in corso"/></StackPanel><Button Grid.Column="1" x:Name="CancelButton" Content="Annulla" Click="Cancel_Click" Visibility="Collapsed" VerticalAlignment="Center"/></Grid>
      </Border>
      <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="FilterToolbar" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><Label Content="Cerca nome, produttore o versione" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,5" FontSize="12" Foreground="{StaticResource Muted}"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Height="35" Padding="9,6" FontSize="14" BorderBrush="#C4D1D9" MaxLength="300" AutomationProperties.Name="Cerca driver e aggiornamenti"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0"><Label Content="Firma del driver" Target="{Binding ElementName=SignatureFilter}" Padding="0,0,0,5" FontSize="12" Foreground="{StaticResource Muted}"/><ComboBox x:Name="SignatureFilter" Width="155" Height="35" SelectedIndex="0" SelectionChanged="Signature_Changed" AutomationProperties.Name="Filtra per firma"><ComboBoxItem Content="Tutte le firme"/><ComboBoxItem Content="Firmati"/><ComboBoxItem Content="Non firmati"/><ComboBoxItem Content="Firma sconosciuta"/></ComboBox></StackPanel>
            <Button Grid.Column="2" x:Name="RefreshButton" Content="Rileggi driver" Click="Refresh_Click" Margin="16,0,0,0" VerticalAlignment="Bottom" MinHeight="35" Padding="12,8"/>
          </Grid>
          <TabControl Grid.Row="1" BorderThickness="0" SelectionChanged="Tabs_Changed" x:Name="Tabs">
            <TabItem Header="Driver installati"><DataGrid x:Name="DriversGrid" AutomationProperties.Name="Elenco driver installati"><DataGrid.Columns><DataGridTextColumn Header="DISPOSITIVO" Binding="{Binding Name}" Width="2*" MinWidth="180"/><DataGridTextColumn Header="PRODUTTORE" Binding="{Binding Provider}" Width="*" MinWidth="105"/><DataGridTextColumn Header="VERSIONE" Binding="{Binding Version}" Width="*" MinWidth="110"/><DataGridTextColumn Header="DATA" Binding="{Binding Date}" Width="105"/><DataGridTextColumn Header="FIRMA" Binding="{Binding Signature}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Aggiornamenti disponibili"><DataGrid x:Name="UpdatesGrid" AutomationProperties.Name="Proposte di Windows Update"><DataGrid.Columns><DataGridTextColumn Header="AGGIORNAMENTO" Binding="{Binding Title}" Width="2*" MinWidth="240"/><DataGridTextColumn Header="PRODUTTORE" Binding="{Binding Manufacturer}" Width="*" MinWidth="120"/><DataGridTextColumn Header="DATA DRIVER" Binding="{Binding Date}" Width="110"/><DataGridCheckBoxColumn Header="FACOLTATIVO" Binding="{Binding Optional}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="DriverPack"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Analizza gli INF estratti oppure apri il catalogo online/offline con il motore originale SDIO." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Normal"/>
              <WrapPanel Grid.Row="1"><Button x:Name="ChoosePackButton" Content="Scegli cartella" Click="ChoosePack_Click" Margin="0,0,8,8"/><Button x:Name="AnalyzePackButton" Content="Analizza INF" Click="AnalyzePack_Click" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="SdioButton" Content="Apri catalogo SDIO ↗" Click="Sdio_Click" Background="#087A68" Foreground="White" Margin="0,0,8,8"/><Button x:Name="ImportSdioButton" Content="Importa ZIP SDIO" Click="ImportSdio_Click" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Grid.Row="2" x:Name="PackStatus" Text="Scegli una cartella locale o USB. I pacchetti e gli indici SDIO restano sulla cartella scelta." FontWeight="Normal" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
              <DataGrid Grid.Row="3" x:Name="PacksGrid" SelectionChanged="DeviceSelection_Changed" AutomationProperties.Name="Driver compatibili nei pacchetti locali"><DataGrid.Columns><DataGridTextColumn Header="DISPOSITIVO" Binding="{Binding DeviceName}" Width="2*" MinWidth="160"/><DataGridTextColumn Header="DRIVER CANDIDATO" Binding="{Binding Description}" Width="2*" MinWidth="160"/><DataGridTextColumn Header="VERSIONE" Binding="{Binding Version}" Width="*" MinWidth="100"/><DataGridTextColumn Header="FIRMA" Binding="{Binding Signature}" Width="130"/></DataGrid.Columns></DataGrid>
              <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Compatibilità, sistema e architettura verificati da Windows.&#x0a;Una corrispondenza non garantisce un aggiornamento migliore." TextWrapping="Wrap" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="InstallPackButton" Content="Installa pacchetto" Click="InstallPack_Click" IsEnabled="False" Background="#087A68" Foreground="White"/></Grid>
            </Grid></TabItem>
            <TabItem Header="Ripristino"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,22"><TextBlock Text="Prima dei driver, un punto fermo." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Crea un punto di ripristino Windows prima di cambiare i driver. Permette di tornare a una configurazione precedente; non è un backup dei documenti." FontWeight="Normal" FontSize="14" LineHeight="23" TextWrapping="Wrap" Margin="0,12,0,18"/><WrapPanel><Button x:Name="CreateRestoreButton" Content="Crea punto di ripristino" Click="CreateRestore_Click" Background="#087A68" Foreground="White" Margin="0,0,10,10"/><Button Content="Apri Protezione sistema ↗" Click="Protection_Click" Margin="0,0,10,10"/><Button Content="Apri ripristino Windows ↗" Click="Recovery_Click" Margin="0,0,0,10"/></WrapPanel><Border Background="#E7EEF3" Padding="16" CornerRadius="8" Margin="0,12,0,0"><TextBlock x:Name="RestoreStatus" Text="Richiede autorizzazione amministrativa e Protezione sistema attiva. Windows può limitare la frequenza dei punti: l'app verifica che ne sia stato creato uno nuovo, senza modificare questi limiti." TextWrapping="Wrap" FontWeight="Normal" FontSize="13" LineHeight="22"/></Border></StackPanel></ScrollViewer></TabItem>
          </TabControl>
          <Grid x:Name="InventoryFooter" Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ListHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Text="In attesa dell'inventario locale."/>
            <Button Grid.Column="1" x:Name="SupportButton" Content="Supporto produttore ↗" Click="Support_Click" IsEnabled="False" Padding="12,8" MinHeight="36" FontSize="12" ToolTip="Seleziona un driver di un produttore riconosciuto per aprire il sito ufficiale."/>
            <Button Grid.Column="1" x:Name="InstallButton" Content="Installa selezionato" Click="Install_Click" IsEnabled="False" Visibility="Collapsed" Background="#087A68" Foreground="White" Padding="14,8" MinHeight="36"/>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Nessuna proposta non garantisce l'ultima versione di ogni driver." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="AppUpdateStatus" Text="CosmoDriver si aggiorna automaticamente da GitHub." FontSize="11" Foreground="#087A68" TextWrapping="Wrap" Margin="0,5,0,0"/><Button x:Name="RestartUpdateButton" Content="Riavvia e aggiorna CosmoDriver" Click="RestartUpdate_Click" Visibility="Collapsed" Margin="0,7,0,0" HorizontalAlignment="Left" MinHeight="32" Padding="10,5"/></StackPanel>
        <Button Grid.Column="1" x:Name="ExportButton" Content="Esporta rapporto" Click="Export_Click" IsEnabled="False"/>
        <Button Grid.Column="2" Content="Apri Windows Update ↗" Click="WindowsUpdate_Click" Margin="10,0,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
